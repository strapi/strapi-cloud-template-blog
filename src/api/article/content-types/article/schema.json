{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Corporate press, market updates, and insights"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "target_domain": {
      "type": "enumeration",
      "enum": [
        "Corporate Only",
        "Kenya Commercial Only",
        "All Domains"
      ],
      "default": "All Domains"
    },
    "category": {
      "type": "string"
    },
    "content": {
      "type": "blocks"
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "published_date": {
      "type": "date"
    }
  }
}
